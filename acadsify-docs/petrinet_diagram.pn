<net>
  <places>
    <place id="p1" name="Users"/>
    <place id="p2" name="Courses"/>
    <place id="p3" name="Appointments"/>
    <place id="p4" name="Completions"/>
    <place id="p5" name="Engagements"/>
  </places>
  <transitions>
    <transition id="t1" name="User Registration"/>
    <transition id="t2" name="Course Enrollment"/>
    <transition id="t3" name="Appointment Scheduling"/>
    <transition id="t4" name="Task Completion"/>
    <transition id="t5" name="Engagement Tracking"/>
  </transitions>
  <arcs>
    <arc from="p1" to="t1"/>
    <arc from="t1" to="p1"/>
    <arc from="p1" to="t2"/>
    <arc from="p2" to="t2"/>
    <arc from="t2" to="p2"/>
    <arc from="p1" to="t3"/>
    <arc from="p3" to="t3"/>
    <arc from="t3" to="p3"/>
    <arc from="p1" to="t4"/>
    <arc from="p2" to="t4"/>
    <arc from="t4" to="p4"/>
    <arc from="p1" to="t5"/>
    <arc from="p2" to="t5"/>
    <arc from="t5" to="p5"/>
  </arcs>
</net>
